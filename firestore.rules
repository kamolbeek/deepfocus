rules_version = '2';

// Har bir foydalanuvchi faqat o'zining ma'lumotini ko'radi va yozadi
service cloud.firestore {
  match /databases/{database}/documents {
    // Telegram'ni ulash uchun bir martalik kod: faqat o'zi uchun yarata oladi, o'qiy olmaydi.
    // Kodni server (bot) xizmat hisobi bilan o'qiydi va o'chiradi.
    match /linkCodes/{code} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.exp is int
        && request.resource.data.keys().hasOnly(['uid', 'exp']);
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /tasks/{taskId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 300
          && request.resource.data.estimate is int
          && request.resource.data.done is int;
      }

      match /sessions/{sessionId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.minutes is int
          && request.resource.data.minutes > 0
          && request.resource.data.minutes <= 600;
      }
    }
  }
}
